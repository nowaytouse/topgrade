#!/usr/bin/env python3.15
"""Topgrade MAS gate: confirm fast catalog candidates before updating."""

from __future__ import annotations

import json
import subprocess
import sys
from pathlib import Path
from typing import Any, Optional, Set

MAS = Path("/opt/homebrew/bin/mas")


class MasGateError(Exception):
    pass


def query(args: list[str], label: str, allowed_ids: Optional[Set[int]] = None) -> list[int]:
    result = subprocess.run(
        [str(MAS), *args],
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        if result.stdout:
            sys.stderr.write(result.stdout)
            if not result.stdout.endswith("\n"):
                sys.stderr.write("\n")
        if result.stderr:
            sys.stderr.write(result.stderr)
            if not result.stderr.endswith("\n"):
                sys.stderr.write("\n")
        raise MasGateError(f"{label} failed with exit status {result.returncode}")
    if result.stderr:
        sys.stderr.write(result.stderr)

    ids: list[int] = []
    seen: set[int] = set()
    for line_number, line in enumerate(result.stdout.splitlines(), 1):
        if not line.strip():
            raise MasGateError(f"{label} returned blank output line {line_number}")
        try:
            row: Any = json.loads(line)
        except json.JSONDecodeError as exc:
            raise MasGateError(f"{label} returned invalid JSON on line {line_number}: {exc.msg}") from exc
        if not isinstance(row, dict):
            raise MasGateError(f"{label} returned a non-object on line {line_number}")
        app_id = row.get("adamID")
        if isinstance(app_id, bool) or not isinstance(app_id, int) or app_id <= 0:
            raise MasGateError(f"{label} returned invalid positive integer adamID on line {line_number}")
        installed_version = row.get("version")
        new_version = row.get("newVersion")
        if (
            not isinstance(installed_version, str)
            or not installed_version.strip()
            or not isinstance(new_version, str)
            or not new_version.strip()
        ):
            raise MasGateError(f"{label} returned invalid version/newVersion strings on line {line_number}")
        if installed_version == new_version:
            raise MasGateError(f"{label} returned equal version and newVersion for adamID {app_id}")
        if app_id in seen:
            raise MasGateError(f"{label} returned duplicate adamID {app_id}")
        if allowed_ids is not None and app_id not in allowed_ids:
            raise MasGateError(f"{label} returned unselected adamID {app_id}")
        seen.add(app_id)
        ids.append(app_id)
    return ids


def main() -> int:
    try:
        candidates = query(["outdated", "--inaccurate", "--json"], "inaccurate MAS query")
        if not candidates:
            print("MAS: current (inaccurate catalog found no candidates)")
            return 0

        candidate_args = [str(app_id) for app_id in candidates]
        candidate_set = set(candidates)
        verified = query(
            ["outdated", "--accurate", "--json", *candidate_args],
            "accurate MAS candidate verification",
            candidate_set,
        )
        if not verified:
            print(
                "MAS: current; inaccurate catalog candidate(s) "
                + ", ".join(candidate_args)
                + " were not pending in the accurate App Store check"
            )
            return 0

        verified_args = [str(app_id) for app_id in verified]
        print(
            "MAS: accurate App Store check confirmed update candidate(s): "
            + ", ".join(verified_args),
            flush=True,
        )
        update = subprocess.run(
            [str(MAS), "upgrade", "--accurate", *verified_args],
            check=False,
        )
        if update.returncode != 0:
            return update.returncode

        remaining = query(
            ["outdated", "--accurate", "--json", *verified_args],
            "post-upgrade accurate MAS verification",
            set(verified),
        )
        if remaining:
            raise MasGateError(
                "MAS upgrade returned success but update(s) remain: "
                + ", ".join(str(app_id) for app_id in remaining)
            )
        print("MAS: verified current after accurate update")
        return 0
    except MasGateError as exc:
        print(f"MAS verification error: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
